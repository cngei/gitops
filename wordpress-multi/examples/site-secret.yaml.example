# Manual mode only: set externalSecrets.enabled=false before managing this Secret.
# ESO generates this Secret automatically by default.
# This file contains placeholders only. Do not commit actual credentials.
apiVersion: v1
kind: Secret
metadata:
  name: cn27-wordpress-secret
  namespace: wordpress
type: Opaque
stringData:
  WORDPRESS_DB_HOST: wordpress-multi-mariadb.wordpress.svc.cluster.local:3306
  # Match sites[].database.name/username; both default to wp_<subdomain>, with
  # hyphens replaced by underscores. See README for very long labels.
  WORDPRESS_DB_NAME: wp_cn27
  WORDPRESS_DB_USER: wp_cn27
  WORDPRESS_DB_PASSWORD: REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
  WORDPRESS_SITE_URL: https://cn27.cngei.it
  WORDPRESS_SITE_TITLE: CNGEI CN27
  WORDPRESS_ADMIN_USER: cn27-admin
  WORDPRESS_ADMIN_PASSWORD: REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
  WORDPRESS_ADMIN_EMAIL: admin@example.com
  # Optional: fail startup if a premium plugin's update cannot be downloaded.
  WORDPRESS_STRICT_PLUGIN_UPDATES: "false"


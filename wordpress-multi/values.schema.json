{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "mariadb",
    "sites"
  ],
  "definitions": {
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "keep": {
          "type": "boolean"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany"
            ]
          }
        }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "mariadb": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cleanupPolicy": {
          "enum": [
            "Skip",
            "Delete"
          ]
        },
        "keepResources": {
          "type": "boolean"
        }
      }
    },
    "persistence": {
      "$ref": "#/definitions/persistence"
    },
    "cron": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string"
        },
        "image": {
          "type": "string"
        }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "domain"
            ],
            "additionalProperties": false,
            "properties": {
              "domain": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.cngei\\.it$"
              },
              "persistence": {
                "$ref": "#/definitions/persistence"
              },
              "database": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_]{1,64}$"
                  },
                  "username": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_]{1,80}$"
                  }
                }
              },
              "secretRevision": {
                "type": "string"
              },
              "resources": {
                "type": "object"
              }
            }
          },
          {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.cngei\\.it$"
          }
        ]
      }
    }
  }
}
